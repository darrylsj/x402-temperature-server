SENSOR_BACKEND=simulated
STATION_ID=roof-demo-01
LOCATION_LABEL=Danville, CA - Sycamore Valley Park reference
LATITUDE=37.8074706
LONGITUDE=-121.9464792
READING_TTL_SECONDS=60

# Simulated sensor mode. Use this until physical BME280/DS18B20 hardware is attached.
SIMULATED_BASE_CELSIUS=21.4
SIMULATED_DAILY_SWING_CELSIUS=3.2
SIMULATED_NOISE_CELSIUS=0.35
SIMULATED_HUMIDITY=48.3
SIMULATED_PRESSURE_HPA=1013.2

# BME280 hardware mode
I2C_ADDRESS=0x76

# DS18B20 hardware mode
DS18B20_DEVICE_GLOB=/sys/bus/w1/devices/28-*/w1_slave

# x402 paid mode. Leave disabled for local tests.
ENABLE_X402=false
ENABLE_MOCK_X402=false
X402_PRICE_USD=0.001
X402_NETWORK=base
PAY_TO_EVM_ADDRESS=0x0000000000000000000000000000000000000000
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Cloud collector mode. Use this on the cheap cloud VPS when Pi nodes post readings here.
ENABLE_CLOUD_COLLECTOR=false
STATION_INGEST_TOKEN=
INGEST_MAX_AGE_SECONDS=900

# Node/Circle Gateway proxy. X402_GATEWAY_MODE=mock is for local unpaid/paid-contract tests.
ARCHITECTURE=edge
X402_GATEWAY_MODE=mock
SENSOR_ORIGIN=http://127.0.0.1:8080
SELLER_ADDRESS=0x0000000000000000000000000000000000000000
PRICE_USD=0.001
FACILITATOR_URL=https://gateway-api-testnet.circle.com
